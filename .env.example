# DK8s local development settings.
# Copy this file to .env (which git ignores) and edit .env if needed:
#   cp .env.example .env
# These are disposable local-only values. Never put real secrets in this file.

# --- Read by Docker Compose (compose.yaml) to set up the PostgreSQL container ---
POSTGRES_DB=dk8s
POSTGRES_USER=dk8s
POSTGRES_PASSWORD=dk8s
# Port on your machine that forwards to PostgreSQL's port 5432 inside the container.
POSTGRES_PORT=5432

# --- Read by control-api (Spring Boot) to connect to that database ---
# Keep these in sync with the values above: same user and password,
# and the port in DB_URL must equal POSTGRES_PORT.
DB_URL=jdbc:postgresql://localhost:5432/dk8s
DB_USERNAME=dk8s
DB_PASSWORD=dk8s
