# DK8s local development settings.
# Copy this file to .env (which git ignores) and edit .env if needed:
#   cp .env.example .env
# These are disposable local-only values. Never put real secrets in this file.

# --- Read by Docker Compose (compose.yaml) to set up the PostgreSQL container ---
POSTGRES_DB=dk8s
POSTGRES_USER=dk8s
POSTGRES_PASSWORD=dk8s
# Port on your machine that forwards to PostgreSQL's port 5432 inside the container.
POSTGRES_PORT=5432

# --- Read by control-api (Spring Boot) to connect to that database ---
# Keep these in sync with the values above: same user and password,
# and the port in DB_URL must equal POSTGRES_PORT.
DB_URL=jdbc:postgresql://localhost:5432/dk8s
DB_USERNAME=dk8s
DB_PASSWORD=dk8s

# --- Read by Docker Compose to set up the Solace PubSub+ broker ---
SOLACE_ADMIN_PASSWORD=admin
# Port on your machine for SMF, the messaging protocol the Java apps use.
SOLACE_SMF_PORT=55554
# Port on your machine for the Solace Broker Manager web UI (http://localhost:8081).
SOLACE_MANAGER_PORT=8081

# --- Read by control-api and worker to connect to the broker ---
# The port in SOLACE_HOST must equal SOLACE_SMF_PORT.
SOLACE_HOST=tcp://localhost:55554
SOLACE_VPN=default
SOLACE_USERNAME=default
SOLACE_PASSWORD=default
# Broker management API (SEMP) that control-api reads queue statistics from.
SOLACE_SEMP_URL=http://localhost:8081
SOLACE_ADMIN_USERNAME=admin
